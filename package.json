    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "fetch-data": "tsx scripts/fetch-kartverket.ts",
    "fixture": "tsx scripts/make-fixture.ts",
    "check-data": "tsx scripts/check-data.ts",
    "icons": "node scripts/make-icons.mjs"
  },
